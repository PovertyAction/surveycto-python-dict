# Copy to .env (git-ignored) and fill in. Never commit .env or the key.

# SurveyCTO server: the subdomain only (acme for https://acme.surveycto.com)
SCTO_SERVER=
SCTO_USER=
SCTO_PASSWORD=
# Private key of an encrypted form
SCTO_KEY_PATH=

# The study's non-response codes: code=meaning pairs separated by ;
SCTO_SENTINELS="-99=Don't know;-88=Refused;-77=Not applicable;-66=Other (specify);-55=Not in list"
# Required with [pii] mask: the secret the masks are hashed with. Keep it private:
# with it, a mask can be matched to a guessed value.
# SCTO_MASK_SALT=
# Optional: dates the team types into a date question to code the same answers
# SCTO_DATE_SENTINELS="1900-01-01=Don't know;1900-01-02=Refused"
